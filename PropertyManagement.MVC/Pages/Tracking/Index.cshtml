@page
@model PropertyManagement.MVC.Pages.Tracking.IndexModel
@{
    ViewData["Title"] = "Maintenance Request Lookup";
    // Disables external layout inheritance to prevent conflicting styles
    Layout = null;

    // Safely look up status string for the pipeline indicator if a request was found
    string currentStatus = "";
    System.Text.Json.JsonElement resultElement = default;
    if (Model.Input.Found && !string.IsNullOrEmpty(Model.Input.JsonResult))
    {
        resultElement = System.Text.Json.JsonDocument.Parse(Model.Input.JsonResult).RootElement;
        if (resultElement.TryGetProperty("status", out var st))
        {
            currentStatus = st.GetString() ?? "";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: system-ui, -apple-system, sans-serif;
        }

        .fw-black {
            font-weight: 800;
        }

        .card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #0d6efd;
        }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">

                <div class="text-center mb-5">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-gradient text-white rounded-circle p-3 mb-3 shadow-sm">
                        <i class="bi bi-shield-wrench fs-2"></i>
                    </div>
                    <h2 class="fw-black text-dark mb-1" style="font-size: 2.2rem;">Resident Care Portal</h2>
                    <p class="text-muted small text-uppercase fw-semibold tracking-wider m-0" style="letter-spacing: 1px;">Property Management Support Pipeline</p>
                </div>

                <div class="card mb-4 bg-white">
                    <div class="card-body p-4 p-md-5">
                        <div class="mb-4">
                            <h5 class="fw-bold text-dark mb-1">🔍 Maintenance Request Lookup</h5>
                            <p class="text-muted small mb-0">Track your real-time processing status anytime without authenticated profile sign-ins.</p>
                        </div>

                        <form method="post" asp-page="Index">
                            <div class="row g-3">
                                <div class="col-md-12 mb-2">
                                    <label asp-for="Input.TicketNumber" class="form-label small fw-bold text-secondary text-uppercase" style="font-size: 0.75rem;">Maintenance Ticket ID</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-ticket-perforated"></i></span>
                                        <input asp-for="Input.TicketNumber" class="form-control border-start-0 bg-light p-2.5" placeholder="e.g. TKT-1001" />
                                    </div>
                                    <span asp-validation-for="Input.TicketNumber" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-md-12 mb-3">
                                    <label asp-for="Input.Phone" class="form-label small fw-bold text-secondary text-uppercase" style="font-size: 0.75rem;">Registered Contact Phone</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                        <input asp-for="Input.Phone" class="form-control border-start-0 bg-light p-2.5" placeholder="e.g. 555-0199" />
                                    </div>
                                    <span asp-validation-for="Input.Phone" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold text-uppercase shadow-sm" style="letter-spacing: 0.5px; font-size: 0.9rem;">
                                        <i class="bi bi-search me-2"></i> Verify & Track Progress
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Input.ErrorMessage))
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center p-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-3 flex-shrink-0"></i>
                        <div class="fw-medium">@Model.Input.ErrorMessage</div>
                    </div>
                }

                @if (Model.Input.Found && !string.IsNullOrEmpty(Model.Input.JsonResult))
                {
                    <div class="card overflow-hidden mt-4 bg-white shadow">

                        <div class="card-header bg-dark bg-gradient text-white p-4 border-0">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                <div>
                                    <span class="text-white-50 small text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Assignment Dossier</span>
                                    <h4 class="mb-0 fw-bold" style="font-size: 1.4rem;"><i class="bi bi-bookmark-star me-2 text-warning"></i>Ticket #@(resultElement.TryGetProperty("ticketNumber", out var tn) ? tn.GetString() : "-")</h4>
                                </div>
                                <div>
                                    <span class="badge bg-warning text-dark px-4 py-2.5 rounded-pill fw-bold text-uppercase shadow-sm" style="font-size: 0.8rem;">
                                        <i class="bi bi-activity me-1"></i> @(resultElement.TryGetProperty("status", out var st) ? st.GetString() : "Unknown")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            <div class="row g-4 mb-5">
                                <div class="col-md-7">
                                    <label class="text-muted small text-uppercase fw-bold d-block mb-1" style="font-size:0.7rem; letter-spacing:0.5px;">Reported Structural Issue</label>
                                    <h4 class="fw-bold text-dark mb-4" style="font-size: 1.5rem;">@(resultElement.TryGetProperty("title", out var ti) ? ti.GetString() : "-")</h4>

                                    <label class="text-muted small text-uppercase fw-bold d-block mb-1" style="font-size:0.7rem; letter-spacing:0.5px;">Location Coordinates</label>
                                    <p class="fs-5 fw-semibold text-secondary mb-0">
                                        <i class="bi bi-building text-primary me-2"></i>
                                        Grandview Heights <span class="text-muted fw-normal">|</span> Suite @(resultElement.TryGetProperty("unitNumber", out var un) ? un.GetString() : "N/A")
                                    </p>
                                </div>

                                <div class="col-md-5 bg-light rounded-3 p-4 border border-light">
                                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-secondary border-opacity-10">
                                        <span class="text-muted small fw-medium">Core Category:</span>
                                        <span class="badge bg-secondary px-2 py-1">@(resultElement.TryGetProperty("category", out var cat) ? cat.GetString() : "-")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-secondary border-opacity-10">
                                        <span class="text-muted small fw-medium">System Priority:</span>
                                        <span class="badge bg-danger px-2 py-1">@(resultElement.TryGetProperty("priority", out var pri) ? pri.GetString() : "-")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-secondary border-opacity-10">
                                        <span class="text-muted small fw-medium">Logged Date:</span>
                                        <span class="text-dark fw-bold small">
                                            @(resultElement.TryGetProperty("createdAt", out var ca) ? DateTime.Parse(ca.GetString()!).ToString("dd-MMM-yy") : "-")
                                        </span>
                                    </div>

                                    @if (resultElement.TryGetProperty("resolvedAt", out var ra) && ra.ValueKind != System.Text.Json.JsonValueKind.Null)
                                    {
                                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-secondary border-opacity-10">
                                            <span class="text-muted small fw-medium">Resolved On:</span>
                                            <span class="text-success fw-bold small">@DateTime.Parse(ra.GetString()!).ToString("dd-MMM-yy")</span>
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-center pt-1">
                                        <span class="text-muted small fw-medium">Assigned Engineer:</span>
                                        <span class="text-dark fw-bold small">
                                            <i class="bi bi-person-badge text-primary me-1"></i>
                                            @(resultElement.TryGetProperty("assignedStaffName", out var asn) && asn.ValueKind != System.Text.Json.JsonValueKind.Null ? asn.GetString() : "Pending assignment")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4 text-muted opacity-25" />

                            <h6 class="text-center fw-bold text-uppercase tracking-widest text-secondary mb-4" style="font-size:0.75rem; letter-spacing: 1.5px;">Real-time Pipeline Status Workflow</h6>

                            <div class="position-relative py-3">
                                <div class="position-absolute start-0 end-0 bg-secondary opacity-25" style="height: 4px; top: 32px; z-index: 0;"></div>

                                <div class="d-flex justify-content-between align-items-start position-relative" style="z-index: 1;">

                                    <div class="text-center" style="width: 25%;">
                                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto shadow" style="width: 40px; height: 40px;">
                                            <i class="bi bi-check-lg fs-5"></i>
                                        </div>
                                        <span class="small d-block mt-2 fw-bold text-success text-uppercase" style="font-size: 0.65rem;">Received</span>
                                    </div>

                                    <div class="text-center" style="width: 25%;">
                                        @if (currentStatus == "Assigned" || currentStatus == "InProgress" || currentStatus == "Resolved" || currentStatus == "Closed")
                                        {
                                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto shadow" style="width: 40px; height: 40px;">
                                                <i class="bi bi-check-lg fs-5"></i>
                                            </div>
                                            <span class="small d-block mt-2 fw-bold text-success text-uppercase" style="font-size: 0.65rem;">Assigned</span>
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-white border border-2 text-muted d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 40px; height: 40px;">
                                                <i class="bi bi-person-gear opacity-50"></i>
                                            </div>
                                            <span class="small d-block mt-2 text-muted text-uppercase fw-semibold" style="font-size: 0.65rem;">Assigned</span>
                                        }
                                    </div>

                                    <div class="text-center" style="width: 25%;">
                                        @if (currentStatus == "InProgress" || currentStatus == "Resolved" || currentStatus == "Closed")
                                        {
                                            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center mx-auto shadow" style="width: 40px; height: 40px;">
                                                <i class="bi bi-tools fs-5"></i>
                                            </div>
                                            <span class="small d-block mt-2 fw-bold text-warning text-uppercase" style="font-size: 0.65rem;">In Progress</span>
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-white border border-2 text-muted d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 40px; height: 40px;">
                                                <i class="bi bi-hourglass opacity-50"></i>
                                            </div>
                                            <span class="small d-block mt-2 text-muted text-uppercase fw-semibold" style="font-size: 0.65rem;">In Progress</span>
                                        }
                                    </div>

                                    <div class="text-center" style="width: 25%;">
                                        @if (currentStatus == "Resolved" || currentStatus == "Closed")
                                        {
                                            <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center mx-auto shadow" style="width: 40px; height: 40px;">
                                                <i class="bi bi-trophy fs-5"></i>
                                            </div>
                                            <span class="small d-block mt-2 fw-bold text-info text-uppercase" style="font-size: 0.65rem;">Resolved</span>
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-white border border-2 text-muted d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 40px; height: 40px;">
                                                <i class="bi bi-flag opacity-50"></i>
                                            </div>
                                            <span class="small d-block mt-2 text-muted text-uppercase fw-semibold" style="font-size: 0.65rem;">Resolved</span>
                                        }
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>