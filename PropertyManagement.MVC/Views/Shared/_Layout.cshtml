<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Property Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                🏢 PropertyMS
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        @if (User.IsInRole("PropertyManager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PropertyManager"
                                   asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#"
                                   data-bs-toggle="dropdown">Properties</a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyManager"
                                           asp-action="Buildings">Buildings</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyManager"
                                           asp-action="Units">Units</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyManager"
                                           asp-action="Tenants">Tenants</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#"
                                   data-bs-toggle="dropdown">Operations</a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyManager"
                                           asp-action="Leases">Leases</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyManager"
                                           asp-action="MaintenanceRequests">Maintenance</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyManager"
                                           asp-action="Payments">Payments</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyManager"
                                           asp-action="Staff">Staff</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Tenant"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tenant"
                                   asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tenant"
                                   asp-action="MyLease">My Lease</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tenant"
                                   asp-action="MaintenanceRequests">Maintenance</a>
                            </li>
                        }
                        @if (User.IsInRole("MaintenanceStaff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MaintenanceStaff"
                                   asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MaintenanceStaff"
                                   asp-action="MyRequests">My Requests</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tracking"
                               asp-action="Index">🔍 Public Lookup</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#"
                               data-bs-toggle="dropdown">
                                👤 @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account" asp-action="Logout">
                                        🚪 Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account"
                               asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account"
                               asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted bg-light py-3 mt-5">
        <div class="container text-center">
            <p class="mb-0">© 2026 Property Management System</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>