@{
    ViewData["Title"] = "Property Management System";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-lg border-0">
                <div class="card-body py-5">
                    <h1 class="display-5 fw-bold text-primary mb-2">🏢 Property Management</h1>
                    <p class="text-muted mb-4">Manage buildings, leases, maintenance, and more.</p>
                    <div class="d-grid gap-3">
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-primary btn-lg">🔑 Login</a>
                        <a asp-controller="Account" asp-action="Register"
                           class="btn btn-outline-secondary btn-lg">📝 Register</a>
                        <a asp-controller="Tracking" asp-action="Index"
                           class="btn btn-outline-warning btn-lg">🔍 Track Maintenance Request</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
