@model PropertyManagement.API.Models.Lease
@{
    ViewData["Title"] = "Create Lease";
    var tenants = ViewBag.Tenants as List<PropertyManagement.API.Models.Tenant>
                  ?? new List<PropertyManagement.API.Models.Tenant>();
    var units = ViewBag.Units as List<PropertyManagement.API.Models.Unit>
                ?? new List<PropertyManagement.API.Models.Unit>();
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-white">
                    <h4>📄 Create New Lease</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateLease" method="post">
                        <div class="mb-3">
                            <label asp-for="TenantId" class="form-label">Tenant</label>
                            <select asp-for="TenantId" class="form-select">
                                @foreach (var t in tenants)
                                {
                                    <option value="@t.Id">@t.FullName (@t.Email)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UnitId" class="form-label">Unit</label>
                            <select asp-for="UnitId" class="form-select">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Id">@u.UnitNumber - @u.Building?.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="MonthlyRent" class="form-label">Monthly Rent (BD)</label>
                            <input asp-for="MonthlyRent" type="number" step="0.01" class="form-control" required />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning w-100">Create Lease</button>
                            <a asp-action="Leases" class="btn btn-secondary w-100">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>