@model PropertyManagement.API.Models.Tenant
@{
    ViewData["Title"] = "Edit Tenant";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4>Edit Tenant</h4>
                </div>
                <div class="card-body">

                    <form asp-action="EditTenant" method="post">

                        @* need the id so the controller knows which record to update *@
                        <input type="hidden" asp-for="Id" />

                        @* keep the registration date hidden so we don't overwrite it with empty *@
                        <input type="hidden" asp-for="DateRegistered" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CPR" class="form-label">CPR</label>
                            <input asp-for="CPR" class="form-control" />
                            <span asp-validation-for="CPR" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-info w-100">Save Changes</button>
                            <a asp-action="Tenants" class="btn btn-secondary w-100">Cancel</a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}