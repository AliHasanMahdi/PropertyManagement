@{
    ViewData["Title"] = "Property Manager Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">🏢 Property Manager Dashboard</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow h-100">
                <div class="card-body">
                    <h6 class="card-title">🏗️ Buildings</h6>
                    <h2 class="mb-0">@ViewBag.TotalBuildings</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow h-100">
                <div class="card-body">
                    <h6 class="card-title">🏠 Available Units</h6>
                    <h2 class="mb-0">@ViewBag.AvailableUnits</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white shadow h-100">
                <div class="card-body">
                    <h6 class="card-title">🔧 Pending Requests</h6>
                    <h2 class="mb-0">@ViewBag.PendingRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow h-100">
                <div class="card-body">
                    <h6 class="card-title">💰 Overdue Payments</h6>
                    <h2 class="mb-0">@ViewBag.OverduePayments</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Board Banner -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-danger shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">🔴 Real-Time Maintenance Board</h5>
                        <p class="mb-0 text-muted">Live view of all maintenance requests and staff assignments</p>
                    </div>
                    <a asp-action="MaintenanceBoard" class="btn btn-danger">Open Live Board</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>🏗️ Buildings</h5>
                    <p class="text-muted">Manage all buildings</p>
                    <a asp-action="Buildings" class="btn btn-primary w-100">View Buildings</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>🏠 Units</h5>
                    <p class="text-muted">Manage all units</p>
                    <a asp-action="Units" class="btn btn-success w-100">View Units</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>👥 Tenants</h5>
                    <p class="text-muted">Manage all tenants</p>
                    <a asp-action="Tenants" class="btn btn-info w-100">View Tenants</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>📄 Leases</h5>
                    <p class="text-muted">Manage all leases</p>
                    <a asp-action="Leases" class="btn btn-warning w-100">View Leases</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>🔧 Maintenance</h5>
                    <p class="text-muted">Manage maintenance requests</p>
                    <a asp-action="MaintenanceRequests" class="btn btn-danger w-100">View Requests</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>👷 Staff</h5>
                    <p class="text-muted">Manage maintenance staff</p>
                    <a asp-action="Staff" class="btn btn-secondary w-100">View Staff</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>💰 Payments</h5>
                    <p class="text-muted">Track lease payments</p>
                    <a asp-action="Payments" class="btn btn-dark w-100">View Payments</a>
                </div>
            </div>
        </div>
    </div>
</div>
