@model PropertyManagement.API.Models.Unit
@{
    ViewData["Title"] = "Edit Unit";
    // get the buildings list that was passed from the controller so we can show the dropdown
    var buildings = ViewBag.Buildings as List<PropertyManagement.API.Models.Building>
                    ?? new List<PropertyManagement.API.Models.Building>();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4>Edit Unit</h4>
                </div>
                <div class="card-body">

                    <form asp-action="EditUnit" method="post">

                        <input type="hidden" asp-for="Id" />

                        @* keep the status hidden so we don't accidentally change Available/Occupied *@
                        <input type="hidden" asp-for="Status" />

                        <div class="mb-3">
                            <label asp-for="UnitNumber" class="form-label">Unit Number</label>
                            <input asp-for="UnitNumber" class="form-control" />
                            <span asp-validation-for="UnitNumber" class="text-danger small"></span>
                        </div>

                        @* show the building dropdown so they can move a unit to another building *@
                        <div class="mb-3">
                            <label asp-for="BuildingId" class="form-label">Building</label>
                            <select asp-for="BuildingId" class="form-select">
                                @foreach (var b in buildings)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label">Type</label>
                            <select asp-for="Type" class="form-select">
                                <option value="Apartment">Apartment</option>
                                <option value="Studio">Studio</option>
                                <option value="Office">Office</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Size" class="form-label">Size (m²)</label>
                            <input asp-for="Size" type="number" class="form-control" />
                            <span asp-validation-for="Size" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rent" class="form-label">Monthly Rent (BD)</label>
                            <input asp-for="Rent" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Rent" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amenities" class="form-label">Amenities</label>
                            <input asp-for="Amenities" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success w-100">Save Changes</button>
                            <a asp-action="Units" class="btn btn-secondary w-100">Cancel</a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}