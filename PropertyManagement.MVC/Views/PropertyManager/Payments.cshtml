@model IEnumerable<PropertyManagement.API.Models.Payment>
@{
    ViewData["Title"] = "Payments";
}
<div class="container mt-4">
    <h2 class="mb-4">💰 Payments</h2>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tenant</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>@payment.Id</td>
                            <td>@payment.Lease?.Tenant?.FullName</td>
                            <td>BD @payment.Amount</td>
                            <td>@payment.PaymentDate.ToShortDateString()</td>
                            <td>@(payment.DueDate.HasValue ? payment.DueDate.Value.ToShortDateString() : "-")</td>
                            <td>
                                <span class="badge @(payment.Status == "Paid" ? "bg-success" : "bg-danger")">
                                    @payment.Status
                                </span>
                            </td>
                            <td>@payment.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add Payment Form -->
    <div class="card shadow mt-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">💳 Record New Payment</h5>
        </div>
        <div class="card-body">
            <form asp-action="AddPayment" method="post" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Lease</label>
                    <select name="leaseId" class="form-select" required>
                        <option value="">-- Select Lease --</option>
                        @foreach (var lease in (ViewBag.Leases as IEnumerable<PropertyManagement.API.Models.Lease> ?? Enumerable.Empty<PropertyManagement.API.Models.Lease>()))
                        {
                            <option value="@lease.Id">
                                @lease.Tenant?.FullName – Unit @lease.Unit?.UnitNumber (@lease.Status)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Amount (BD)</label>
                    <input type="number" name="amount" step="0.01" min="0.01"
                           class="form-control" placeholder="0.00" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Due Date</label>
                    <input type="date" name="dueDate" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Notes</label>
                    <input type="text" name="notes" class="form-control"
                           placeholder="e.g. May rent" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>