@model IEnumerable<PropertyManagement.API.Models.Payment>
@{
    ViewData["Title"] = "Payments";
}
<div class="container mt-4">
    <h2 class="mb-4">💰 Payments</h2>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tenant</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>@payment.Id</td>
                            <td>@payment.Lease?.Tenant?.FullName</td>
                            <td>BD @payment.Amount</td>
                            <td>@payment.PaymentDate.ToShortDateString()</td>
                            <td>
                                <span class="badge @(payment.Status == "Paid" ? "bg-success" : "bg-danger")">
                                    @payment.Status
                                </span>
                            </td>
                            <td>@payment.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>