@model PropertyManagement.API.Models.MaintenanceStaff
@{
    ViewData["Title"] = "Edit Staff";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h4>Edit Maintenance Staff</h4>
                </div>
                <div class="card-body">

                    <form asp-action="EditStaff" method="post">

                        @* need the id so the controller knows which staff to update *@
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        @* dropdown for skill type, same options as the create form *@
                        <div class="mb-3">
                            <label asp-for="SkillType" class="form-label">Skill Type</label>
                            <select asp-for="SkillType" class="form-select">
                                <option value="Plumbing">Plumbing</option>
                                <option value="Electrical">Electrical</option>
                                <option value="Carpentry">Carpentry</option>
                                <option value="General">General</option>
                            </select>
                        </div>

                        @* let the manager change availability status too *@
                        <div class="mb-3">
                            <label asp-for="AvailabilityStatus" class="form-label">Availability</label>
                            <select asp-for="AvailabilityStatus" class="form-select">
                                <option value="Available">Available</option>
                                <option value="Busy">Busy</option>
                                <option value="On Leave">On Leave</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-secondary w-100">Save Changes</button>
                            <a asp-action="Staff" class="btn btn-outline-secondary w-100">Cancel</a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}