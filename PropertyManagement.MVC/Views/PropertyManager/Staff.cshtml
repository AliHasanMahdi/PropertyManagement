@model IEnumerable<PropertyManagement.API.Models.MaintenanceStaff>
@{
    ViewData["Title"] = "Maintenance Staff";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👷 Maintenance Staff</h2>
        <a asp-action="CreateStaff" class="btn btn-secondary">+ Add Staff</a>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Skill</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model)
                    {
                        <tr>
                            <td>@staff.FullName</td>
                            <td>@staff.Email</td>
                            <td>@staff.Phone</td>
                            <td>@staff.SkillType</td>
                            <td>
                                <span class="badge @(staff.AvailabilityStatus == "Available" ? "bg-success" : "bg-warning")">
                                    @staff.AvailabilityStatus
                                </span>
                            </td>
                            <td>
                                <a asp-action="EditStaff" asp-route-id="@staff.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form asp-action="DeleteStaff" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this staff member?')">
                                    <input type="hidden" name="id" value="@staff.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>