@model PropertyManagement.API.Models.Tenant
@{
    ViewData["Title"] = "My Dashboard";
}
<div class="container mt-4">
    <h2>👋 Welcome, @Model.FullName!</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <h6>📄 Active Lease</h6>
                    @if (ViewBag.ActiveLease != null)
                    {
                        <p>Unit @ViewBag.ActiveLease.Unit?.UnitNumber</p>
                        <p>@ViewBag.ActiveLease.Unit?.Building?.Name</p>
                    }
                    else
                    {
                        <p>No active lease</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white shadow">
                <div class="card-body text-center">
                    <h6>🔧 Pending Requests</h6>
                    <h2>@ViewBag.PendingRequests</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>📄 My Lease</h5>
                    <a asp-action="MyLease" class="btn btn-primary w-100">View Lease</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>🔧 Maintenance</h5>
                    <a asp-action="MaintenanceRequests" class="btn btn-warning w-100">My Requests</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h5>➕ New Request</h5>
                    <a asp-action="CreateMaintenanceRequest" class="btn btn-danger w-100">Submit Request</a>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.Notifications != null)
    {
        <div class="mt-4">
            <h5>🔔 Recent Notifications</h5>
            @foreach (var n in ViewBag.Notifications)
            {
                <div class="alert alert-info">@n.Message - <small>@n.CreatedAt.ToShortDateString()</small></div>
            }
        </div>
    }
</div>