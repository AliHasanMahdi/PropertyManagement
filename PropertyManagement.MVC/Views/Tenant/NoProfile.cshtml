@{
    ViewData["Title"] = "Profile Not Found";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-warning">
                <div class="card-body py-5">
                    <h1 class="display-4">⚠️</h1>
                    <h3 class="mt-3">Tenant Profile Not Found</h3>
                    <p class="text-muted mt-2">
                        Your account does not have a tenant profile linked to it yet.
                        Please contact the Property Manager to have your profile set up.
                    </p>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary mt-3">
                        🚪 Logout
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
