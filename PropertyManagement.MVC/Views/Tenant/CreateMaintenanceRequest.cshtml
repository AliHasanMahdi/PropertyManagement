@model PropertyManagement.API.Models.MaintenanceRequest
@{
    ViewData["Title"] = "Submit Maintenance Request";
    var units = ViewBag.Units as List<PropertyManagement.API.Models.Unit>
                ?? new List<PropertyManagement.API.Models.Unit>();
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4>🔧 Submit Maintenance Request</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateMaintenanceRequest" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UnitId" class="form-label">Unit</label>
                            <select asp-for="UnitId" class="form-select">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Id">@u.UnitNumber</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="Plumbing">Plumbing</option>
                                <option value="Electrical">Electrical</option>
                                <option value="Carpentry">Carpentry</option>
                                <option value="General">General</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Normal">Normal</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger w-100">Submit</button>
                            <a asp-action="MaintenanceRequests" class="btn btn-secondary w-100">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>