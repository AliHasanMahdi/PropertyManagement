@model IEnumerable<PropertyManagement.API.Models.MaintenanceRequest>
@{
    ViewData["Title"] = "My Maintenance Requests";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🔧 My Maintenance Requests</h2>
        <a asp-action="CreateMaintenanceRequest" class="btn btn-danger">+ New Request</a>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Ticket</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.TicketNumber</td>
                            <td>@r.Title</td>
                            <td>@r.Category</td>
                            <td><span class="badge bg-warning">@r.Priority</span></td>
                            <td><span class="badge bg-info">@r.Status</span></td>
                            <td>@(r.MaintenanceStaff?.FullName ?? "Unassigned")</td>
                            <td>@r.CreatedAt.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>