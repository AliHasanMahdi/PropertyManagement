<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PM Reports</title>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Report"
               asp-action="Dashboard">
                📊 PM Reports
            </a>
            @if (User.Identity!.IsAuthenticated)
            {
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Report"
                       asp-action="Dashboard">Dashboard</a>
                    <a class="nav-link" asp-controller="Report"
                       asp-action="OccupancyReport">Occupancy</a>
                    <a class="nav-link" asp-controller="Report"
                       asp-action="MaintenanceReport">Maintenance</a>
                    <a class="nav-link" asp-controller="Report"
                       asp-action="LeaseReport">Leases</a>
                    <a class="nav-link text-danger"
                       asp-controller="Account"
                       asp-action="Logout">Logout</a>
                </div>
            }
        </div>
    </nav>

    <main class="container mt-4 pb-5">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>