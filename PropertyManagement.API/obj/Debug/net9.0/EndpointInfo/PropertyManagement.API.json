  "components": {
    "schemas": {
      "AddPaymentDto": {
        "type": "object",
        "properties": {
          "amount": {
            "maximum": 1000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
